{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "routes": [
    {
      "src": "^/$",
      "dest": "/public-home.html"
    },
    {
      "src": "^/(about|how|token|status|siindex|contact|join|genesis)$",
      "dest": "/public-home.html"
    },
    {
      "src": "^/privacy$",
      "dest": "/privacy-policy.html"
    },
    {
      "src": "^/terms$",
      "dest": "/terms-of-service.html"
    },
    {
      "src": "^/(app|onboard|claim|epos|data-sovereignty|breach|consent|revoke|royalty|data-nft|data-market)$",
      "dest": "/planned.html"
    },
    {
      "src": "^/pay/([a-z0-9]+)$",
      "dest": "/planned.html"
    },
    {
      "src": "^/d/([a-z0-9-]+)$",
      "dest": "/planned.html"
    },
    {
      "src": "^/(public-home|planned|privacy-policy|terms-of-service)\\.html$",
      "dest": "/$1.html"
    },
    {
      "src": "^/tier0$",
      "dest": "/login.html"
    },
    {
      "src": "^/login\\.html$",
      "dest": "/login.html"
    },
    {
      "src": "^/(.+\\.html)$",
      "dest": "/planned.html"
    },
    {
      "src": "^/(.+\\.(css|js|png|jpg|jpeg|webp|gif|svg|ico|woff|woff2|ttf|xml|txt|json|webmanifest|mp4|webm))$",
      "dest": "/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://*.supabase.co; img-src 'self' data:; media-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    }
  ]
}
